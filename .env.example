# Khawaja Collection — environment template.
# Copy to .env.local and fill in. Never commit .env.local.
#
# In Vite, ANY variable prefixed VITE_ is inlined into the client bundle and is
# therefore public. This is the exact equivalent of Next.js's NEXT_PUBLIC_.
# A server-only secret must NEVER carry the VITE_ prefix.

# Production origin. Canonicals, Open Graph URLs and the sitemap depend on it.
#
# THIS MUST BE THE HOST THE SITE ACTUALLY SERVES ON, INCLUDING www OR NOT.
# Vercel redirects one to the other with a 308, and if this names the
# redirecting host then every canonical, every og:url and all 93 sitemap
# entries point at a redirect — which Search Console reports as "page with
# redirect" and which makes it ambiguous which host you meant. That happened:
# the value was the apex while the site served on www.
#
# For Khawaja Collection the canonical host is www.
VITE_SITE_URL=https://www.khawajacollection.com

# Which ProductRepository implementation to load: "mock" (Phases 1–7) or
# "supabase" (Phase 8+). Defaults to "mock" when unset.
VITE_PRODUCT_REPOSITORY=mock

# Supabase — Phase 8. Public, browser-safe values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase service role — SERVER ONLY. No VITE_ prefix, by design.
# Never referenced from a component, only from server routes.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Payment gateways — JazzCash and Easypaisa.
#
# TWO LOCKS, AND THEY ARE NOT THE SAME LOCK.
#
#   VITE_PAYMENTS_*   PUBLIC. Decides whether the option is OFFERED at
#                     checkout. Safe in the bundle: it says "this shop takes
#                     JazzCash", which is on the footer of every Pakistani
#                     storefront anyway.
#
#   everything else   SERVER ONLY. No VITE_ prefix, ever. The server refuses
#                     to start a payment when these are missing, whatever the
#                     public flag says.
#
# ⚠ NEITHER GATEWAY HAS BEEN RUN AGAINST A SANDBOX. The code follows the
# published specs but has never taken a real payment. Run each sandbox flow
# end to end and check every field against your merchant pack BEFORE setting
# a VITE_PAYMENTS_* flag to "on".

VITE_PAYMENTS_JAZZCASH=
VITE_PAYMENTS_EASYPAISA=

# From the JazzCash merchant pack. JAZZCASH_ENV is "sandbox" (default) or "live".
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENV=sandbox

# From the Easypaisa merchant pack. The hash key is optional — some accounts
# are issued without one, and the request is then sent unhashed.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ENV=sandbox
